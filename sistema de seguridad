#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <EEPROM.h>
#include <Servo.h>

const char* ssid="TU_WIFI";
const char* wifiPassword="TU_PASSWORD";

ESP8266WebServer server(80);

#define EEPROM_SIZE 64

String password="admin";

#define SERVO_PIN D1
#define LIGHT_PIN D2
#define AIR_PIN D3

Servo doorServo;

bool doorState=false;
bool lightState=false;
bool airState=false;


void cors(){
    server.sendHeader("Access-Control-Allow-Origin","*");
}


void loadPassword(){

    EEPROM.begin(EEPROM_SIZE);

    String saved="";

    for(int i=0;i<32;i++){

        char c=EEPROM.read(i);

        if(c==0) break;

        saved+=c;
    }

    if(saved.length()>0)
        password=saved;


    Serial.print("Password actual: ");
    Serial.println(password);
}


void savePassword(String pass){

    EEPROM.begin(EEPROM_SIZE);

    for(int i=0;i<32;i++)
        EEPROM.write(i,i<pass.length()?pass[i]:0);

    EEPROM.commit();

    Serial.println("Password guardada");
}


void login(){

    cors();

    String body=server.arg("plain");

    Serial.println("\n--- LOGIN ---");
    Serial.print("Recibido: ");
    Serial.println(body);

    Serial.print("Esperado: ");
    Serial.println(password);


    if(body.indexOf(password)>=0){

        Serial.println("Login correcto");

        server.send(200,"text/plain","OK");

    }else{

        Serial.println("Login incorrecto");

        server.send(401,"text/plain","ERROR");

    }
}



void control(){

    cors();

    String body=server.arg("plain");

    Serial.println("\n--- CONTROL ---");
    Serial.println(body);


    bool state=body.indexOf("\"state\":1")>=0;


    if(body.indexOf("\"device\":\"door\"")>=0){

        doorState=state;
        doorServo.write(state?90:0);

        Serial.println(state?"Puerta abierta":"Puerta cerrada");
    }


    if(body.indexOf("\"device\":\"light\"")>=0){

        lightState=state;
        digitalWrite(LIGHT_PIN,state);

        Serial.println(state?"Luz ON":"Luz OFF");
    }


    if(body.indexOf("\"device\":\"air\"")>=0){

        airState=state;
        digitalWrite(AIR_PIN,state);

        Serial.println(state?"Aire ON":"Aire OFF");
    }


    server.send(200,"text/plain","OK");
}



void status(){

    cors();

    String json="{";

    json+="\"door\":";
    json+=doorState?"true":"false";

    json+=",\"light\":";
    json+=lightState?"true":"false";

    json+=",\"air\":";
    json+=airState?"true":"false";

    json+="}";


    Serial.println("Estado enviado:");
    Serial.println(json);


    server.send(200,"application/json",json);
}



void changePassword(){

    cors();

    String body=server.arg("plain");


    Serial.println("\n--- CAMBIO PASSWORD ---");
    Serial.println(body);


    int oldPos=body.indexOf("\"old\":\"");
    int newPos=body.indexOf("\"new\":\"");


    if(oldPos>=0 && newPos>=0){

        String oldPass=body.substring(
            oldPos+7,
            body.indexOf("\"",oldPos+7)
        );


        String newPass=body.substring(
            newPos+7,
            body.indexOf("\"",newPos+7)
        );


        Serial.print("Vieja: ");
        Serial.println(oldPass);

        Serial.print("Nueva: ");
        Serial.println(newPass);


        if(oldPass==password){

            password=newPass;

            savePassword(password);

            server.send(200,"text/plain","OK");

            return;
        }
    }


    server.send(401,"text/plain","ERROR");
}



void setup(){

    Serial.begin(115200);

    Serial.println("\nIniciando ESP8266");


    loadPassword();


    pinMode(LIGHT_PIN,OUTPUT);
    pinMode(AIR_PIN,OUTPUT);

    digitalWrite(LIGHT_PIN,LOW);
    digitalWrite(AIR_PIN,LOW);


    doorServo.attach(SERVO_PIN);
    doorServo.write(0);


    Serial.println("Conectando WiFi...");

    WiFi.begin(ssid,wifiPassword);


    while(WiFi.status()!=WL_CONNECTED){

        delay(500);
        Serial.print(".");
    }


    Serial.println("\nWiFi conectado");

    Serial.print("IP: ");
    Serial.println(WiFi.localIP());


    server.on("/login",HTTP_POST,login);
    server.on("/control",HTTP_POST,control);
    server.on("/status",HTTP_GET,status);
    server.on("/password",HTTP_POST,changePassword);


    server.begin();


    Serial.println("Servidor HTTP iniciado");
}



void loop(){

    server.handleClient();

}